#pragma code_page(65001)
#include <windows.h>
#include "version.h"  // CMakeLists.txt のバージョン番号から生成される

// app.ico は badge-preview.exe --ico で作る
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "IME インジケーター"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "ime-indicator"
            VALUE "LegalCopyright", "Copyright (c) IME Indicator contributors. MIT License."
            VALUE "OriginalFilename", "ime-indicator.exe"
            VALUE "ProductName", "IME インジケーター"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
